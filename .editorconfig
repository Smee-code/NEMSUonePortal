# EditorConfig — enforce one consistent encoding/whitespace across every editor
# and OS, so files are always saved as UTF-8 (prevents mojibake like
# "2026â€“2027"). https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
