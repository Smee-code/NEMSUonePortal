# ══════════════════════════════════════════════════════════════════════════════
# NEMSUonePortal — Required Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ── Django Core ───────────────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret-key-at-least-50-characters

DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database (SQLite) ─────────────────────────────────────────────────────────
# Optional. Absolute path to the SQLite database file.
# Defaults to backend/db.sqlite3 when unset.
# DB_NAME=

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Must be at least 64 characters (512 bits) for HS256 security
JWT_SECRET_KEY=replace-with-a-minimum-64-character-random-hex-string-for-jwt-signing

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── Frontend URL (used in email links) ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Encoding (prevents mojibake like "2026â€“2027") ────────────────────────────
# Force Python to use UTF-8 for file I/O on every OS (Windows defaults to the
# cp1252 codepage otherwise). These must be REAL environment variables set BEFORE
# Python starts — the interpreter reads PYTHONUTF8 at startup, so listing them in
# .env (read later by python-decouple) is not enough. Set them in your shell or
# the PythonAnywhere WSGI file:
#   PowerShell:          $env:PYTHONUTF8 = "1"
#   bash:                export PYTHONUTF8=1
#   PythonAnywhere WSGI: os.environ["PYTHONUTF8"] = "1"   (near the top of the file)
# PYTHONUTF8=1
# PYTHONIOENCODING=utf-8

# ── Email ─────────────────────────────────────────────────────────────────────
# Use console backend in local dev (prints emails to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@nemsu.edu.ph
